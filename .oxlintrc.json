{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".local/**",
    "audience/.wrangler/**",
    "audience/worker-configuration.d.ts",
    "reports/**",
    ".stryker-tmp/**"
  ],
  "overrides": [
    {
      "files": [
        "public/**/*.ts",
        "shared/**/*.ts",
        "audience/audience.ts",
        "audience/worker.ts",
        "audience/room-*.ts",
        "audience/stage-state.ts",
        "audience/feedback-http.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "node:*",
                  "assert",
                  "assert/strict",
                  "async_hooks",
                  "buffer",
                  "child_process",
                  "cluster",
                  "console",
                  "constants",
                  "crypto",
                  "dgram",
                  "diagnostics_channel",
                  "dns",
                  "dns/promises",
                  "domain",
                  "events",
                  "fs",
                  "fs/promises",
                  "http",
                  "http2",
                  "https",
                  "inspector",
                  "inspector/promises",
                  "module",
                  "net",
                  "os",
                  "path",
                  "path/posix",
                  "path/win32",
                  "perf_hooks",
                  "process",
                  "punycode",
                  "querystring",
                  "readline",
                  "readline/promises",
                  "repl",
                  "stream",
                  "stream/consumers",
                  "stream/promises",
                  "stream/web",
                  "string_decoder",
                  "sys",
                  "timers",
                  "timers/promises",
                  "tls",
                  "trace_events",
                  "tty",
                  "url",
                  "util",
                  "util/types",
                  "v8",
                  "vm",
                  "wasi",
                  "worker_threads",
                  "zlib",
                  "node:sea",
                  "node:sqlite",
                  "node:test",
                  "node:test/reporters"
                ],
                "message": "Node APIs belong in the local service or tooling, not browser/shared/Worker runtime modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["shared/models.ts"],
      "rules": {
        "typescript/no-restricted-types": [
          "error",
          {
            "types": {
              "unknown": "Shared domain models must describe known fields. Keep unknown at unvalidated input boundaries."
            }
          }
        ]
      }
    }
  ],
  "rules": {
    "typescript/no-explicit-any": "error"
  }
}
