{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lecture-votes-20260909-bfbeb2745cce",
  "account_id": "3118f9560af77a0819ba24e1a14bcc9e",
  "routes": [
    {
      "pattern": "live.scalableweb.dev",
      "zone_name": "scalableweb.dev",
      "custom_domain": true,
    },
  ],
  "main": "worker.ts",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "dev": { "host": "127.0.0.1" },
  "preview_urls": false,
  "secrets": { "required": ["PRESENTER_TOKEN"] },
  "build": { "command": "node --import tsx build-assets.ts" },
  "assets": {
    "directory": "../.local/audience/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_STATE", "class_name": "RoomState" },
      { "name": "STAGE_STATE", "class_name": "StageState" },
      { "name": "QUESTION_SESSIONS", "class_name": "QuestionSession" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomState"] },
    { "tag": "v2", "new_sqlite_classes": ["StageState"] },
    { "tag": "v3", "new_sqlite_classes": ["QuestionSession"] },
  ],
}
