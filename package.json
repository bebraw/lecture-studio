{
  "name": "lecture-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run build && node --import tsx --env-file-if-exists=.env server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run test:browser",
    "build": "node --import tsx scripts/build-browser.ts",
    "typecheck": "npm run typegen && tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "npm run types --prefix audience"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "markdown-it": "15.0.1",
    "mermaid": "11.17.2",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.13.4",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
