# All services stay on this computer. Do not commit credentials.
LECTURE_PORT=4317
LECTURE_WORKSPACE=../webdev-rehearsal-studio
# Optional override for the installed Codex CLI; no shell arguments here.
# LECTURE_CODEX_BIN=/absolute/path/to/codex
# Obsidian defaults to the obsidian entry in ~/.codex/config.toml.
# OBSIDIAN_MCP_URL=http://127.0.0.1:27200/mcp/
# OBSIDIAN_API_KEY must be present in the launching environment if required.

# Public audience app connection (not the private studio URL).
# LECTURE_POLL_ORIGIN=https://your-demo.workers.dev
# LECTURE_POLL_ROOM=webdev-2026
# LECTURE_POLL_TOKEN must match that app's PRESENTER_TOKEN.
# Supply it through your environment or ignored .env, never in the join link.
